","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":53,"status":"ok","timestamp":1760143962610,"user":{"displayName":"Md Nazmul Hossain","userId":"00750796264808723498"},"user_tz":360},"id":"78e4aa0e-2a7d-44cc-9f8b-b3593c1e8176","outputId":"facbf562-980e-445e-cafa-b6a6f33d3ad0"},"outputs":[{"name":"stdout","output_type":"stream","text":["Hello, World! Welcome to the Student Gradebook Management System.\n"]}],"source":["# In the space below, please print \"Hello, World! Welcome to the Student Gradebook Management System.\"\n","print(\"Hello, World! Welcome to the Student Gradebook Management System.\")"]},{"cell_type":"code","execution_count":null,"id":"l3Venmnzsq2m","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":46,"status":"ok","timestamp":1760143963614,"user":{"displayName":"Md Nazmul Hossain","userId":"00750796264808723498"},"user_tz":360},"id":"l3Venmnzsq2m","outputId":"18017b95-2a8d-4f39-d01d-d0bc8df14557"},"outputs":[{"name":"stdout","output_type":"stream","text":["This is implemented by Group 2, for ENGG680 Fall  of 2025\n"]}],"source":["# Fill in your information using the defined variables below:\n","# (1 mark)\n","lab_group_number = 2\n","intake_year = 2025\n","intake_semester = \"Fall \" #\"Fall\" or \"Winter\"\n","\n","# Using f-strings and the variables above, print \"This is implemented by Group <lab_group_number>, for ENGG680 <intake_semester> of <intake_year>\"\n","# (1 marks)\n","print(f\"This is implemented by Group {lab_group_number}, for ENGG680 {intake_semester} of {intake_year}\")"]},{"cell_type":"code","execution_count":null,"id":"mX5gdzQGp9Bu","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":66,"status":"ok","timestamp":1760143986714,"user":{"displayName":"Md Nazmul Hossain","userId":"00750796264808723498"},"user_tz":360},"id":"mX5gdzQGp9Bu","outputId":"4f8e9f5c-a71e-47c7-b2c9-0dce681c73a3"},"outputs":[{"name":"stdout","output_type":"stream","text":["Our group members include Mohammad, Iftekhar, Nazmul, and Haider.\n"]}],"source":["# Similarly, create variables for each of your group members (eg. member_1, member_2....) and assign them your first names.\n","# Then, using f-strings and the variables above, print the following sentence:\n","# \"Our Group Members include <member_1>, <member_2>, ...\"\n","# (1 marks)\n","member1 = \"Mohammad\"\n","member2 = \"Iftekhar\"\n","member3 = \"Nazmul\"\n","member4 = \"Haider\"\n","\n","print(f\"Our group members include {member1}, {member2}, {member3}, and {member4}.\")"]},{"cell_type":"code","execution_count":null,"id":"mTPZ16XEtnHV","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":24,"status":"ok","timestamp":1760143988881,"user":{"displayName":"Md Nazmul Hossain","userId":"00750796264808723498"},"user_tz":360},"id":"mTPZ16XEtnHV","outputId":"18e785f4-9601-4af5-c9b0-e2f1769b4ac9"},"outputs":[{"name":"stdout","output_type":"stream","text":["The subjects involved in this grading system is English and Math.\n"]}],"source":["# Use indexing to print \"The subjects involved in this grading system is English and Math.\" using \"subjects\" below.\n","# (1 marks)\n","subjects = (\"English\", \"Math\")\n","print(f\"The subjects involved in this grading system is {subjects[0]} and {subjects[1]}.\")"]},{"cell_type":"markdown","id":"Cew8JQKs8IlV","metadata":{"id":"Cew8JQKs8IlV"},"source":["## Part 2: Python Fundamentals\n","### (11 Marks)"]},{"cell_type":"code","execution_count":null,"id":"lf2eJW36AHJn","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":24,"status":"ok","timestamp":1760143991335,"user":{"displayName":"Md Nazmul Hossain","userId":"00750796264808723498"},"user_tz":360},"id":"lf2eJW36AHJn","outputId":"00d6d70e-0624-4818-d811-5a16962dbf4a"},"outputs":[{"name":"stdout","output_type":"stream","text":["['Edmonton', 'Calgary', 'Airdrie', 'Banff', 'Canmore']\n","['Banff', 'Calgary', 'Canmore', 'Chestermere', 'Edmonton']\n"]}],"source":["# Lists (2 marks)\n","\n","# 1. Create a list of any 5 cities in Alberta.\n","Name_5_Cities_in_Alberta = [\"Edmonton\", \"Calgary\", \"Airdrie\", \"Banff\", \"Canmore\"]\n","\n","# 2. Print the list\n","print(Name_5_Cities_in_Alberta)\n","\n","# 3. Add a new city to list.\n","Name_5_Cities_in_Alberta.append(\"Chestermere\")\n","\n","# 4. Remove the second city using either remove() or pop().\n","Name_5_Cities_in_Alberta.remove(\"Airdrie\")\n","\n","# 5. Sort the list alphabetically\n","Name_5_Cities_in_Alberta.sort()\n","\n","# 6. Print your final list\n","print(Name_5_Cities_in_Alberta)"]},{"cell_type":"code","execution_count":null,"id":"rr53uJwQ9uAe","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":26,"status":"ok","timestamp":1760143995194,"user":{"displayName":"Md Nazmul Hossain","userId":"00750796264808723498"},"user_tz":360},"id":"rr53uJwQ9uAe","outputId":"396f10bb-9272-433c-cbac-030ac4b4a765"},"outputs":[{"name":"stdout","output_type":"stream","text":["(5, 11, 27)\n","\n","Attempting to modify the second element results in a TypeError: 'tuple' object does not support item assignment\n"]}],"source":["# Tuples (2 marks)\n","\n","# 1. Create a tuple of 3 favorite numbers.\n","favorite_numbers_03 = (5, 11, 27)\n","\n","# 2. Print the tuple.\n","print(favorite_numbers_03)\n","\n","# 3. Try to modify the second element. Does that work? Explain.\n","try:\n","  favorite_numbers_03[1] = 15\n","except TypeError as e:\n","  print(f\"\\nAttempting to modify the second element results in a TypeError: {e}\")"]},{"cell_type":"code","execution_count":null,"id":"abx1OwgJW6hw","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":37,"status":"ok","timestamp":1760143952096,"user":{"displayName":"Md Nazmul Hossain","userId":"00750796264808723498"},"user_tz":360},"id":"abx1OwgJW6hw","outputId":"00a9ee43-8832-4484-9656-e9d9faa9752b"},"outputs":[{"name":"stdout","output_type":"stream","text":["{'Name': 'Jon', 'File Number': 30051021, 'Country': 'Canada', 'Visa Type': 'Study Permit', 'Expiry Year': 2025}\n","{'Name': 'Jon', 'File Number': 30051021, 'Country': 'Canada', 'Visa Type': 'Study Permit', 'Expiry Year': 2026, 'University': 'University of calgary'}\n"]}],"source":["# Dictionaries (2 marks)\n","\n","# 1. Create a dictionary representing a mini visa form with keys like:\n","# \"Name\", \"File Number\", \"Country\", \"Visa Type\", \"Expiry Year\"\n","# Assign fictional values to the keys.\n","# Note: Dictionaries can contain values of different data types.\n","person = {\n","    'Name': 'Jon',\n","    'File Number': 30051021,\n","    'Country': 'Canada',\n","    'Visa Type': 'Study Permit',\n","    'Expiry Year': 2025\n","}\n","\n","# 2. Print the dictionary\n","print(person)\n","\n","# 3. Add a new key \"University\" with a value\n","person['University'] = 'University of calgary'\n","\n","# 4. Update \"Expiry Year\" to a new year\n","person['Expiry Year'] = 2026\n","\n","# 5. Print the final dictionary\n","print(person)"]},{"cell_type":"code","execution_count":null,"id":"uqp6pK8VZGD9","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":54,"status":"ok","timestamp":1760144006198,"user":{"displayName":"Md Nazmul Hossain","userId":"00750796264808723498"},"user_tz":360},"id":"uqp6pK8VZGD9","outputId":"8bbe1194-fde8-43d4-f991-3cfdcafdbbf2"},"outputs":[{"name":"stdout","output_type":"stream","text":["Subjects1: {'Biology', 'Math', 'English', 'Physics', 'History'}\n","Subjects2: {'Chemistry', 'Math', 'Geography', 'Physics', 'English'}\n","Union: {'Physics', 'History', 'Biology', 'Math', 'Geography', 'Chemistry', 'English'}\n","Intersection: {'Math', 'Physics', 'English'}\n","Difference (subjects1 - subjects2): {'History', 'Biology'}\n"]}],"source":["# Sets (2 marks)\n","\n","# Set 1\n","subjects1 = {\"Math\", \"English\", \"Physics\", \"Biology\", \"History\"}\n","\n","# Set 2\n","subjects2 = {\"Math\", \"English\", \"Chemistry\", \"Geography\", \"Physics\"}\n","\n","# Tip: Use f-strings to print clear messages along with your output.\n","# Eg. \"Union: \", \"Intersection: \"\n","\n","# 1. Print both the sets\n","print(f\"Subjects1: {subjects1}\")\n","print(f\"Subjects2: {subjects2}\")\n","\n","# 2. Print the union of sets\n","print(f\"Union: {subjects1.union(subjects2)}\")\n","\n","# 3. Print the intersection of sets\n","print(f\"Intersection: {subjects1.intersection(subjects2)}\")\n","\n","# 4. Print the difference (subjects1 - subjects2)\n","print(f\"Difference (subjects1 - subjects2): {subjects1.difference(subjects2)}\")"]},{"cell_type":"code","execution_count":null,"id":"kAEpKNfQtl8n","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":33,"status":"ok","timestamp":1760144008704,"user":{"displayName":"Md Nazmul Hossain","userId":"00750796264808723498"},"user_tz":360},"id":"kAEpKNfQtl8n","outputId":"7b6a6a07-423a-43fa-c842-307915efb8ce"},"outputs":[{"name":"stdout","output_type":"stream","text":["Bank Name: Canada Bank\n","Iftekhar deposited $500. New balance: $1500\n","Iftekhar withdrew $200. New balance: $1300\n","Iftekhar's current balance: $1300\n"]}],"source":["# Classes and Function (3 marks)\n","\n","# Step 1: Create a class BankAccount.\n","class BankAccount:\n","# Add class attribute bankname=\"Canada Bank\"\n","# Class attribute\n","    bankname = \"Canada Bank\"\n","# Add 2 instance attributes: account_holder (string) & balance (float, default value 0.0)\n","    def __init__(self, account_holder, balance=0.0):\n","        self.account_holder = account_holder\n","        self.balance = balance\n","\n","# Step 2: Add methods\n","# Method 1: Deposit money\n","    def deposit(self, amount):\n","        self.balance += amount\n","        print(f\"{self.account_holder} deposited ${amount}. New balance: ${self.balance}\")\n","\n","# Method 2: Withdraw money\n","    def withdraw(self, amount):\n","        if self.balance >= amount:\n","            self.balance -= amount\n","            print(f\"{self.account_holder} withdrew ${amount}. New balance: ${self.balance}\")\n","        else:\n","            print(f\"Insufficient balance! {self.account_holder} has only ${self.balance}\")\n","\n","# Method 3: Get balance\n","    def get_balance(self):\n","        print(f\"{self.account_holder}'s current balance: ${self.balance}\")\n","\n","# Method 4: Get bank name (staticmethod)\n","    @staticmethod\n","    def get_bankname():\n","      print(f\"Bank Name: {BankAccount.bankname}\")\n","\n","\n","# Step 3: Test\n","# 1. Print the Bankname\n","BankAccount.get_bankname()\n","\n","# 2. Create an object with your name and initial balance\n","account1 = BankAccount(\"Iftekhar\", 1000)\n","\n","# 3. Deposit 500\n","account1.deposit(500)\n","\n","# 4. Withdraw 200\n","account1.withdraw(200)\n","\n","# 5. Print final balance\n","account1.get_balance()"]},{"cell_type":"markdown","id":"b45a5575-8e77-4bba-8311-69f997affc35","metadata":{"id":"b45a5575-8e77-4bba-8311-69f997affc35"},"source":["## Part 3: Using Pandas for Data Management and Analytics\n","### (15 marks)"]},{"cell_type":"code","execution_count":null,"id":"6dbaa42e-22e3-4aa6-9bd3-dd9ede274c17","metadata":{"id":"6dbaa42e-22e3-4aa6-9bd3-dd9ede274c17"},"outputs":[],"source":["# In the space below, please import the Pandas library\n","import pandas as pd"]},{"cell_type":"code","execution_count":null,"id":"cce8e74f-bba1-4bf4-baaf-13e23cdf4afc","metadata":{"id":"cce8e74f-bba1-4bf4-baaf-13e23cdf4afc"},"outputs":[],"source":["# Load the student grade CSV files into DataFrames using the defined variables\n","# (1 marks)\n","df_english = pd.read_csv(\"/content/studentGrades_English.csv\")\n","df_math = pd.read_csv(\"/content/studentGrades_Math.csv\")"]},{"cell_type":"code","execution_count":null,"id":"O0FyC8aftofz","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":22,"status":"ok","timestamp":1760144019044,"user":{"displayName":"Md Nazmul Hossain","userId":"00750796264808723498"},"user_tz":360},"id":"O0FyC8aftofz","outputId":"1261d175-f7db-4f3a-af79-b012d5ffb0c6"},"outputs":[{"name":"stdout","output_type":"stream","text":["  firstName  lastName  studentID  grade\n","0      Emma     Smith      10959     95\n","1    Sophia  Robinson      75175     88\n","2      Emma    Taylor      42257     87\n","3     David  Robinson      55148     86\n","4   Stephen     Curry      30303     90\n"]}],"source":["# Print the first 5 rows of df_english using the .head method\n","print(df_english.head())"]},{"cell_type":"code","execution_count":null,"id":"G-RxspCFtrsf","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":22,"status":"ok","timestamp":1760144020936,"user":{"displayName":"Md Nazmul Hossain","userId":"00750796264808723498"},"user_tz":360},"id":"G-RxspCFtrsf","outputId":"5ab1276e-226f-4e13-8202-94d4df0a7aec"},"outputs":[{"name":"stdout","output_type":"stream","text":["  firstName lastName  studentID  grade\n","0     James    Jones      87707     92\n","1     Sarah    Swift      61026     98\n","2      Anne    Clark      90449     99\n","3      Ryan   Thomas      62137     89\n","4    Daniel    White      25477     87\n"]}],"source":["# Print the first 5 rows of df_math using the .head method\n","print(df_math.head())"]},{"cell_type":"code","execution_count":null,"id":"8fb240f4-6358-4f61-ab12-f0134c0144a8","metadata":{"id":"8fb240f4-6358-4f61-ab12-f0134c0144a8"},"outputs":[],"source":["# Merging the DataFrames on 'studentID'\n","df_studentGrades = pd.merge(df_english, df_math, on='studentID', suffixes=('_English', '_Math'))"]},{"cell_type":"code","execution_count":null,"id":"a9e571ef-d61b-4594-a181-503dca3fe49b","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":25,"status":"ok","timestamp":1760488785266,"user":{"displayName":"Md Nazmul Hossain","userId":"00750796264808723498"},"user_tz":360},"id":"a9e571ef-d61b-4594-a181-503dca3fe49b","outputId":"9d284270-813d-4596-c437-f2c3c89b50b8"},"outputs":[{"name":"stdout","output_type":"stream","text":["Is studentID unique in English Data?  True\n","Is studentID unique in Math Data?  True\n"]}],"source":["# Take a look at the data contained in the csv files. Why is studentID chosen as the key?\n","print(\"Is studentID unique in English Data? \", df_english['studentID'].is_unique)\n","print(\"Is studentID unique in Math Data? \", df_math['studentID'].is_unique)"]},{"cell_type":"code","execution_count":null,"id":"CLN5Yot1Rdqo","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":19,"status":"ok","timestamp":1760488787018,"user":{"displayName":"Md Nazmul Hossain","userId":"00750796264808723498"},"user_tz":360},"id":"CLN5Yot1Rdqo","outputId":"0eeb9e13-6f2a-4549-83a9-b54af7273b45"},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","English studentIDs: [10959, 75175, 42257, 55148, 30303]\n","Math studentIDs: [87707, 61026, 90449, 62137, 25477]\n","\n","Merged Data :\n","   firstName_English lastName_English  studentID  grade_English firstName_Math  \\\n","0              Emma            Smith      10959             95           Emma   \n","1            Sophia         Robinson      75175             88         Sophia   \n","2              Emma           Taylor      42257             87           Emma   \n","3             David         Robinson      55148             86          David   \n","4           Stephen            Curry      30303             90        Stephen   \n","\n","  lastName_Math  grade_Math  \n","0         Smith          90  \n","1      Robinson          95  \n","2        Taylor          85  \n","3      Robinson          87  \n","4         Curry          88  \n"]}],"source":["print(\"\\nEnglish studentIDs:\", df_english['studentID'].head().tolist())\n","print(\"Math studentIDs:\", df_math['studentID'].head().tolist())\n","\n","# Merge DataFrames\n","df_studentGrades = pd.merge(